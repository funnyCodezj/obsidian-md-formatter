{
  "name": "obsidian-md-formatter",
  "version": "1.0.0",
  "description": "一键美化 Markdown 文档排版，支持自定义规则模板",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "markdown",
    "formatter",
    "md"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "js-yaml": "^4.1.0",
    "obsidian": "^1.7.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
